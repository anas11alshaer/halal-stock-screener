# Secrets (required). Copy to .env and fill in. Never commit .env.
# Shariah thresholds: config/screening_policy.toml
# App knobs: config/app.toml (CACHE_TTL_HOURS / LOG_LEVEL may also be set here).

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (production screenshot parser until Issue #7 slice 7)
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM API key (screenshot bake-off; build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Your contact email for SEC EDGAR User-Agent — not an API key.
# Use an inbox you read. The SEC does not issue this; they email you if
# the crawler misbehaves. Required for live N-PORT / companyfacts.
SEC_CONTACT_EMAIL=you@example.com
