# Required: create a private bot with @BotFather and paste its NEW token here.
# Never commit your real token. Revoke any token that has appeared in logs.
TELEGRAM_BOT_TOKEN=

# Free default screening providers.
# Musaffa and Zoya use public pages. Daleel works without a key at 10 requests/minute.
SCREENING_PROVIDER_PLUGINS=scrapers.musaffa:MusaffaScraper,scrapers.zoya:ZoyaScraper,scrapers.daleel:DaleelProvider

# To enable all configured providers (requires HALAL_TERMINAL_API_KEY and HALAL_SCREENER_API_KEY):
# SCREENING_PROVIDER_PLUGINS=scrapers.musaffa:MusaffaScraper,scrapers.zoya:ZoyaScraper,scrapers.daleel:DaleelProvider,scrapers.halal_terminal:HalalTerminalProvider,scrapers.halal_screener:HalalScreenerProvider

# Cache confirmed verdicts for 24 hours and confirmed not-covered responses for 1 hour.
CACHE_TTL_HOURS=24
NOT_COVERED_CACHE_TTL_HOURS=1

# Optional: Daleel's free key raises its limit to 30 requests/minute and enables batching.
DALEEL_API_KEY=

# Optional providers. These keys do nothing unless their provider class is also added to
# SCREENING_PROVIDER_PLUGINS. Check each provider's current terms and display rights.
HALAL_TERMINAL_API_KEY=
HALAL_SCREENER_API_KEY=

# Optional Gemini features: image ticker extraction and parser-failure evidence review.
# Leave all three values empty for a completely token-free screening workflow.
GEMINI_API_KEY=
EVIDENCE_REVIEWER_PLUGIN=
IMAGE_EXTRACTOR_PLUGIN=

# To enable Gemini features after adding a free Gemini API key, use:
# EVIDENCE_REVIEWER_PLUGIN=reviewer:GeminiEvidenceReviewer
# IMAGE_EXTRACTOR_PLUGIN=image_parser:GeminiImageExtractor

# Delivery channels: comma-separated module:Class list; each runs in its own thread.
DELIVERY_CHANNEL_PLUGINS=channels.telegram:TelegramChannel

# Bearer token for the internal GET /screen JSON endpoint. Callers must send
# "Authorization: Bearer <token>"; the endpoint returns 403 until this is set. Used by the whale_scout
# service over the Docker network.
SCREEN_API_TOKEN=

# DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO
